<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_24"
        android:paddingTop="@dimen/vs_24"
        android:paddingEnd="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_8">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/vs_48"
            android:layout_height="@dimen/vs_48"
            android:layout_marginEnd="@dimen/vs_12"
            android:src="@drawable/ic_logo" />

        <com.wuming.android.tv.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_16"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="false"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/font_headline" >
            <tag android:id="@id/tag_typography_role" android:value="headline" />
        </com.wuming.android.tv.ui.custom.CustomTitleView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/font_headline"
            tools:text="09:20:00" >
            <tag android:id="@id/tag_typography_role" android:value="headline" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.wuming.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.wuming.android.tv.ui.custom.CustomVerticalGridView
            android:id="@+id/recycler"
            style="@style/FocusSafePosterGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/vs_8"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.wuming.android.tv.ui.custom.ProgressLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
