<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="@dimen/vs_24" android:gravity="center" android:orientation="horizontal">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/code" android:layout_width="@dimen/vs_250"
            android:layout_height="@dimen/vs_250" android:contentDescription="@string/dlna_pairing_qr" />
        <TextView android:id="@+id/qrHint" android:layout_width="@dimen/vs_250"
            android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="@dimen/vs_16" android:textColor="@color/white" android:textSize="@dimen/font_body" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </TextView>
    </LinearLayout>
    <LinearLayout android:layout_width="@dimen/vs_0" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginStart="@dimen/vs_24" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/dlna_pairing_title" android:textSize="@dimen/font_headline" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="headline" />
        </TextView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16" android:text="@string/dlna_pairing_instructions"
            android:textSize="@dimen/font_title" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="title" />
        </TextView>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16" android:textSize="@dimen/font_title" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="title" />
        </TextView>
        <TextView android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16" android:padding="@dimen/vs_12" android:background="@drawable/selector_item"
            android:focusable="true" android:clickable="true" android:nextFocusDown="@id/revoke"
            android:text="@string/dlna_pairing_refresh" android:textSize="@dimen/font_title" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="title" />
        </TextView>
        <TextView android:id="@+id/revoke" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8" android:padding="@dimen/vs_12" android:background="@drawable/selector_item"
            android:focusable="true" android:clickable="true" android:nextFocusUp="@id/refresh" android:nextFocusDown="@id/editName"
            android:text="@string/dlna_pairing_revoke" android:textSize="@dimen/font_title" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="title" />
        </TextView>
        <TextView android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8" android:padding="@dimen/vs_12" android:background="@drawable/selector_item"
            android:focusable="true" android:clickable="true" android:nextFocusUp="@id/revoke"
            android:text="@string/dlna_name_edit" android:textSize="@dimen/font_title" android:textColor="@color/white" >
            <tag android:id="@id/tag_typography_role" android:value="title" />
        </TextView>
    </LinearLayout>
</LinearLayout>
