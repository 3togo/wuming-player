<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/vs_24">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dlna_name_hint" android:textColor="?attr/dialogOnSurface" android:textSize="@dimen/font_body" >
        <tag android:id="@id/tag_typography_role" android:value="body" />
    </TextView>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/name"
                android:foreground="@drawable/tv_focus_outline"
                android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16" android:singleLine="true"
        android:inputType="text" android:imeOptions="actionDone"
        android:hint="@string/dlna_name_title" android:textColor="?attr/dialogOnSurface"
        android:textColorHint="?attr/dialogOnSurfaceVariant" android:textSize="@dimen/font_title" >
        <tag android:id="@id/tag_typography_role" android:value="title" />
    </androidx.appcompat.widget.AppCompatEditText>
</LinearLayout>
