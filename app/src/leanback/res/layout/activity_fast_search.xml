<?xml version="1.0" encoding="utf-8"?>
<!-- Fast Search Activity - Parallel Multi-Source Search -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_24"
        android:layout_marginTop="@dimen/vs_24"
        android:layout_marginEnd="@dimen/vs_24"
        android:layout_marginBottom="@dimen/vs_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mSearchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="@dimen/vs_16"
            android:shadowColor="@color/black"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:text="@string/grid_search_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/font_headline"
            android:textStyle="bold" >
            <tag android:id="@id/tag_typography_role" android:value="headline" />
        </TextView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridViewWordFenci"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- layout_width is overridden programmatically by LeanbackFastSearchActivity.initViewWidgets()
             using LayoutConfig.getSiteColumnWidthPixels(). Changing it here has no effect. -->
        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/vs_24"
            android:paddingEnd="@dimen/vs_24">

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:focusOutEnd="false"
                app:focusOutFront="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/vs_24"
            android:paddingTop="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_24"
            android:paddingEnd="@dimen/vs_24">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
