<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_item"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/font_body"
        tools:text="蜘蛛人" >
        <tag android:id="@id/tag_typography_role" android:value="body" />
    </com.google.android.material.textview.MaterialTextView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_2"
        android:singleLine="true"
        android:textColor="@color/green_a_400"
        android:textSize="@dimen/font_label"
        tools:text="泥巴"
        tools:visibility="visible" >
        <tag android:id="@id/tag_typography_role" android:value="label" />
    </com.google.android.material.textview.MaterialTextView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_2"
        android:singleLine="true"
        android:textColor="@color/yellow_500"
        android:textSize="@dimen/font_label"
        tools:text="1080p" >
        <tag android:id="@id/tag_typography_role" android:value="label" />
    </com.google.android.material.textview.MaterialTextView>

</androidx.appcompat.widget.LinearLayoutCompat>
