<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_20"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:clickable="true"
        android:nextFocusDown="@id/clip"
        android:foreground="@drawable/tv_focus_outline"
        android:focusable="true"
        android:id="@+id/code"
        android:layout_width="@dimen/vs_250"
        android:layout_height="@dimen/vs_250"
        android:scaleType="fitXY" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_24"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/vs_8"
        android:textColor="@color/white"
        android:textSize="@dimen/font_title" >
        <tag android:id="@id/tag_typography_role" android:value="title" />
    </com.google.android.material.textview.MaterialTextView>

    <com.google.android.material.textview.MaterialTextView
        android:clickable="true"
        android:nextFocusUp="@id/code"
        android:foreground="@drawable/tv_focus_outline"
        android:focusable="true"
        android:id="@+id/clip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16"
        android:background="@drawable/shape_item_normal"
        android:text="@string/push_clip"
        android:textColor="@color/white"
        android:textSize="@dimen/font_title" >
        <tag android:id="@id/tag_typography_role" android:value="title" />
    </com.google.android.material.textview.MaterialTextView>

</androidx.appcompat.widget.LinearLayoutCompat>
