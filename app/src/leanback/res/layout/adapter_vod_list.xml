<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_vod_list"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_vod">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="@dimen/vs_48"
            android:layout_height="@dimen/vs_48"
            android:layout_margin="@dimen/vs_16"
            android:background="@color/black_20"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Grid.Large" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_16"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/font_body"
                tools:text="最近保存" >
                <tag android:id="@id/tag_typography_role" android:value="body" />
            </com.google.android.material.textview.MaterialTextView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white_70"
                android:textSize="@dimen/font_label"
                tools:text="文件夹" >
                <tag android:id="@id/tag_typography_role" android:value="label" />
            </com.google.android.material.textview.MaterialTextView>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
