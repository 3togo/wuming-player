<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/shape_controller"
    android:orientation="vertical"
    android:paddingStart="@dimen/vs_16"
    android:paddingTop="@dimen/vs_18"
    android:paddingEnd="@dimen/vs_16"
    android:paddingBottom="@dimen/vs_8">

    <include
        android:id="@+id/action"
        layout="@layout/view_control_live_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.wuming.android.tv.ui.custom.CustomSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8" />

</androidx.appcompat.widget.LinearLayoutCompat>