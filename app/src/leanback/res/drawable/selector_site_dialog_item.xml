<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only focus gets a white outline; selection keeps its fill when focus moves away. -->
    <item android:drawable="@drawable/shape_site_dialog_item_selected_focused" android:state_focused="true" android:state_activated="true" />
    <item android:drawable="@drawable/shape_site_dialog_item_focused" android:state_focused="true" />
    <item android:drawable="@drawable/shape_site_dialog_item_selected" android:state_activated="true" />
    <item android:drawable="@drawable/shape_site_dialog_item_normal" />
</selector>
