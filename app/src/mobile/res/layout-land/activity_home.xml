<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigation"
        android:layout_width="@dimen/vs_72"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="@color/transparent"
        app:elevation="@dimen/vs_4"
        app:itemActiveIndicatorStyle="@style/Indicator"
        app:itemIconSize="@dimen/vs_24"
        app:itemIconTint="@color/nav"
        app:itemPaddingBottom="@dimen/vs_8"
        app:itemPaddingTop="@dimen/vs_8"
        app:itemRippleColor="@color/blue_500"
        app:itemTextColor="@color/nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/navigation" />

</RelativeLayout>
