<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_search"
        app:navigationIconTint="@android:color/white">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/keyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_4"
            android:background="@null"
            android:hint="@string/search_keyword"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
            android:maxLength="255"
            android:singleLine="true"
            android:textAppearance="@style/ToolbarTextAppearance"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </androidx.appcompat.widget.AppCompatEditText>

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left pane: Search records -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="@dimen/vs_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/vs_16"
                android:paddingEnd="@dimen/vs_8">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_12"
                    android:text="@string/search_record"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_body" >
                    <tag android:id="@id/tag_typography_role" android:value="body" />
                </com.google.android.material.textview.MaterialTextView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recordRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_neg8"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingEnd="@dimen/vs_4"
                    tools:itemCount="5"
                    tools:listitem="@layout/adapter_search_record" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Divider -->
            <View
                android:layout_width="@dimen/vs_1"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/vs_8"
                android:layout_marginBottom="@dimen/vs_8"
                android:background="@color/white_10" />

            <!-- Right pane: Hot words -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="@dimen/vs_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/vs_8"
                android:paddingEnd="@dimen/vs_16">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_12"
                    android:text="@string/search_hot"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_body" >
                    <tag android:id="@id/tag_typography_role" android:value="body" />
                </com.google.android.material.textview.MaterialTextView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wordRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
            android:layout_marginTop="@dimen/vs_neg8"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/vs_4"
                    tools:itemCount="5"
                    tools:listitem="@layout/adapter_search_word" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
