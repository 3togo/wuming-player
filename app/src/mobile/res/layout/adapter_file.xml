<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/vs_8"
    android:background="@drawable/shape_vod_list"
    android:foreground="@drawable/shape_vod"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/vs_12">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="@dimen/vs_40"
        android:layout_height="@dimen/vs_40"
        android:layout_marginEnd="@dimen/vs_12"
        tools:src="@drawable/ic_folder" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="@dimen/font_label"
        tools:text="Download" >
        <tag android:id="@id/tag_typography_role" android:value="label" />
    </com.google.android.material.textview.MaterialTextView>

</androidx.appcompat.widget.LinearLayoutCompat>