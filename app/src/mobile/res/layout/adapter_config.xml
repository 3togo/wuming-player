<?xml version="1.0" encoding="utf-8"?>
<!-- History rows use the shared semantic dialog colors. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="?attr/dialogOnSurface"
        android:textSize="@dimen/font_label"
        android:padding="@dimen/ds_space_medium"
        android:background="@drawable/shape_config_item"
        android:layout_marginEnd="@dimen/ds_space_medium"
        tools:text="https://fongmi.github.io/cat.json" >
        <tag android:id="@id/tag_typography_role" android:value="label" />
    </TextView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete"
        android:layout_width="@dimen/ds_control_min_height"
        android:layout_height="@dimen/ds_control_min_height"
        android:padding="@dimen/ds_space_medium"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_setting_delete" />

</androidx.appcompat.widget.LinearLayoutCompat>
