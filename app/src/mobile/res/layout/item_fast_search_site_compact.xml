<?xml version="1.0" encoding="utf-8"?>
<!-- Fast Search Site Item - Compact Style for Horizontal Layout -->
<!-- Text size is applied by MobileFastListAdapter. Auto-size would override the
     shared compact site typography used by typed-keyword search. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvSearchSite"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/vs_36"
    android:minWidth="@dimen/vs_70"
    android:layout_gravity="center_horizontal"
    android:layout_marginEnd="@dimen/vs_4"
    android:paddingStart="@dimen/vs_4"
    android:paddingEnd="@dimen/vs_4"
    android:background="@drawable/shape_user_search"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:singleLine="true"
    android:textAlignment="center"
    android:textColor="@color/white"
    android:textSize="@dimen/font_label" >
    <tag android:id="@id/tag_typography_role" android:value="label" />
</TextView>
