<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingStart="@dimen/vs_8"
    android:paddingEnd="@dimen/vs_8"
    android:scrollbars="none">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player"
            style="@style/Control"
            android:text="@string/play_exo" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/decode"
            style="@style/Control"
            android:text="@string/play_decode" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/speed"
            style="@style/Control"
            android:fontFeatureSettings="tnum"
            android:text="@string/play_speed" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scale"
            style="@style/Control"
            android:text="@string/play_scale" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reset"
            style="@style/Control"
            android:text="@string/play_reset" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/loop"
            style="@style/Control"
            android:text="@string/play_loop" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <View
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/subtitleTracks"
            style="@style/Control"
            android:tag="3"
            android:text="@string/play_track_text" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audio"
            style="@style/Control"
            android:tag="1"
            android:text="@string/play_track_audio" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/videoTracks"
            style="@style/Control"
            android:tag="2"
            android:text="@string/play_track_video" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/opening"
            style="@style/Control"
            android:text="@string/play_op" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ending"
            style="@style/Control"
            android:text="@string/play_ed" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/danmakuSettings"
            style="@style/Control"
            android:text="@string/danmaku"
            android:visibility="gone"
            tools:visibility="visible" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/actionTitle"
            style="@style/Control"
            android:text="@string/play_title"
            android:visibility="gone"
            tools:visibility="visible" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/episodes"
            style="@style/Control"
            android:text="@string/detail_episode" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/actionInfo"
            style="@style/Control"
            android:text="@string/play_info" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>
</HorizontalScrollView>