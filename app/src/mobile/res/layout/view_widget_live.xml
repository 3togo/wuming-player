<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/vs_24"
        android:background="@drawable/shape_widget"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/font_label"
        android:visibility="gone"
        tools:text="@string/error_play_url"
        tools:visibility="visible" >
        <tag android:id="@id/tag_typography_role" android:value="label" />
    </com.google.android.material.textview.MaterialTextView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/overlaySeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/vs_24"
        android:background="@drawable/shape_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/overlayAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_8"
            android:src="@drawable/ic_widget_rewind" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/white"
            android:textSize="@dimen/font_label"
            tools:text="00:00:00" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/overlaySpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/vs_24"
        android:src="@drawable/ic_widget_forward"
        android:visibility="gone" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/bright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/vs_24"
        android:background="@drawable/shape_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brightIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            tools:src="@drawable/ic_widget_bright_high" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/brightProgress"
            android:layout_width="@dimen/vs_120"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/white"
            app:trackColor="@color/grey_500" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/vs_24"
        android:background="@drawable/shape_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/volumeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            tools:src="@drawable/ic_widget_volume_high" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/volumeProgress"
            android:layout_width="@dimen/vs_120"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/white"
            app:trackColor="@color/grey_500" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/overlayInfo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_56"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_live_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_16"
        android:paddingEnd="@dimen/vs_16"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            android:textColor="@color/white"
            android:textSize="@dimen/font_body"
            tools:text="005" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/vs_44"
            android:layout_height="@dimen/vs_33"
            android:layout_marginEnd="@dimen/vs_12"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            android:maxEms="48"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="@dimen/font_body"
            tools:text="民視" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/overlayPlay"
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="@dimen/font_body"
            tools:text="正在播放：食神" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/overlayLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/font_body"
            tools:text="來源 1" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/info_pip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_live_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_8"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/number_pip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_12"
            android:textColor="@color/white"
            android:textSize="@dimen/font_micro"
            tools:text="005" >
            <tag android:id="@id/tag_typography_role" android:value="micro" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name_pip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="@dimen/font_micro"
            tools:text="民視" >
            <tag android:id="@id/tag_typography_role" android:value="micro" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>