<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:translationY="@dimen/vs_neg40">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="@dimen/vs_160"
        android:layout_height="@dimen/vs_180"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/box_opening" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_empty"
        android:textColor="@color/white"
        android:textSize="@dimen/font_body" >
        <tag android:id="@id/tag_typography_role" android:value="body" />
    </com.google.android.material.textview.MaterialTextView>

</androidx.appcompat.widget.LinearLayoutCompat>
