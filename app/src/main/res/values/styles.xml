<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Single alert-dialog contract shared by mobile and TV. Theme.Base selects this
        overlay for unstyled builders; DarkDialogStyle remains as a compatibility alias
        for older call sites which explicitly request it.
    -->
    <style name="AppDialogStyle.Base" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowIsFloating">true</item>
        <item name="dialogSurface">@color/dialog_surface</item>
        <item name="dialogSurfaceVariant">@color/dialog_surface_variant</item>
        <item name="dialogOnSurface">@color/dialog_on_surface</item>
        <item name="dialogOnSurfaceVariant">@color/dialog_on_surface_variant</item>
        <item name="dialogOutline">@color/dialog_outline</item>
        <item name="dialogRowFocused">@color/dialog_row_focused</item>
        <item name="dialogRowSelected">@color/dialog_row_selected</item>
        <item name="dialogSelectionOutline">@color/dialog_selection_outline</item>
        <item name="android:textColorPrimary">?attr/dialogOnSurface</item>
        <item name="android:textColorSecondary">?attr/dialogOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/dialogOnSurfaceVariant</item>
        <item name="colorSurface">?attr/dialogSurface</item>
        <item name="colorOnSurface">?attr/dialogOnSurface</item>
        <item name="colorOnSurfaceVariant">?attr/dialogOnSurfaceVariant</item>
        <item name="colorOnPrimary">?attr/dialogOnSurface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="AppDialogStyle" parent="AppDialogStyle.Base" />

    <style name="DarkDialogStyle" parent="AppDialogStyle" />

    <style name="SiteDialogStyle" parent="AppDialogStyle" />

    <!-- Applied while inflating custom dialog content, before it enters the dialog. -->
    <style name="AppDialogContentStyle">
        <item name="dialogSurface">@color/dialog_surface</item>
        <item name="dialogSurfaceVariant">@color/dialog_surface_variant</item>
        <item name="dialogOnSurface">@color/dialog_on_surface</item>
        <item name="dialogOnSurfaceVariant">@color/dialog_on_surface_variant</item>
        <item name="dialogOutline">@color/dialog_outline</item>
        <item name="dialogRowFocused">@color/dialog_row_focused</item>
        <item name="dialogRowSelected">@color/dialog_row_selected</item>
        <item name="dialogSelectionOutline">@color/dialog_selection_outline</item>
        <item name="android:textColorPrimary">?attr/dialogOnSurface</item>
        <item name="android:textColorSecondary">?attr/dialogOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/dialogOnSurfaceVariant</item>
        <item name="colorSurface">?attr/dialogSurface</item>
        <item name="colorOnSurface">?attr/dialogOnSurface</item>
        <item name="colorOnSurfaceVariant">?attr/dialogOnSurfaceVariant</item>
        <item name="colorControlNormal">?attr/dialogOnSurfaceVariant</item>
        <item name="colorOnPrimary">?attr/dialogOnSurface</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/ds_corner_dialog</item>
    </style>

    <!-- Player styles for video playback -->
    <!-- IMPORTANT: use_controller MUST remain false. The app uses a custom control overlay
         (view_control_vod.xml / view_control_live.xml) for cast, keep, speed, etc.
         If use_controller is true, ExoPlayer's built-in controller renders on top and
         hides/blocks the custom overlay, causing the cast icon and other controls to
         disappear. See commit 07a9cc4fb for the fix. -->
    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item> <!-- DO NOT ENABLE - breaks custom controls -->
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <style name="Player.Live">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <style name="Player.Cast">
        <item name="keep_content_on_player_reset">false</item>
    </style>

    <!-- Vod image appearance styles -->
    <style name="Vod.Grid" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Vod.Grid.Large" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/ds_corner_small</item>
    </style>

    <style name="Vod.Circle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Video playback overlay text styles (shared by all flavors) -->
    <style name="VideoOverlay">
    </style>
    <style name="VideoOverlay.Info">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">@color/black_90</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/font_caption</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="VideoOverlay.Clock">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:shadowColor">@color/black_90</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/font_caption</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="VideoOverlay.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/font_title</item>
    </style>

</resources>
