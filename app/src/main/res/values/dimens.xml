    <!-- ============================================================== -->
    <!-- Semantic font sizes (sp) - categorized by role, not raw value   -->
    <!-- ============================================================== -->
    <!-- Display: large numbers, channel digits, timer digits            -->
    <dimen name="font_display">@dimen/ds_ui_display_text</dimen>
    <!-- Headline: page main titles, VOD names in detail page            -->
    <dimen name="font_headline">@dimen/ds_ui_headline_text</dimen>
    <!-- Title: section titles, overlay titles, control bar titles       -->
    <dimen name="font_title">@dimen/ds_ui_title_text</dimen>
    <!-- Body: detail info, list items, dialog content                   -->
    <dimen name="font_body">@dimen/ds_ui_body_text</dimen>
    <!-- Label: buttons, tags, secondary info, chips                     -->
    <dimen name="font_label">@dimen/ds_ui_label_text</dimen>
    <!-- Caption: tech params, clock, network warning, smallest text     -->
    <dimen name="font_caption">@dimen/ds_ui_caption_text</dimen>
    <!-- Micro: very small text (mobile live info bar, PIP info)         -->
    <dimen name="font_micro">@dimen/ds_ui_micro_text</dimen>

