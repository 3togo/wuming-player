<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_16"
        android:layout_marginTop="@dimen/vs_16"
        android:text="@string/play_timer"
        android:textColor="?attr/dialogOnSurface"
        android:textSize="@dimen/font_body" >
        <tag android:id="@id/tag_typography_role" android:value="body" />
    </com.google.android.material.textview.MaterialTextView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_16"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_16"
        android:paddingBottom="@dimen/vs_8"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/shape_accent"
            android:tag="5"
            android:text="@string/timer_5"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_label" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/shape_accent"
            android:tag="15"
            android:text="@string/timer_15"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_label" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/shape_accent"
            android:tag="30"
            android:text="@string/timer_30"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_label" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/shape_accent"
            android:tag="60"
            android:text="@string/timer_60"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_label" >
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_24"
            android:layout_marginBottom="@dimen/vs_24"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_display"
            tools:text="5:00" >
            <tag android:id="@id/tag_typography_role" android:value="display" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delay"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:singleLine="true" android:ellipsize="end"
            android:text="@string/timer_delay"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/font_label">
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.button.MaterialButton>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:singleLine="true" android:ellipsize="end"
            android:text="@string/timer_cancel"
            android:textColor="?attr/dialogOnSurface"
            android:textSize="@dimen/font_label">
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.button.MaterialButton>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
