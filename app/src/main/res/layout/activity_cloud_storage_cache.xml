<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_900"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/vs_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cloud_storage_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_12"
                android:text="@string/cloud_storage_back"
                android:textColor="@color/white"
                android:textSize="@dimen/font_title" >
                <tag android:id="@id/tag_typography_role" android:value="title" />
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_20"
                android:text="@string/cloud_storage_cache_title"
                android:textColor="@color/white"
                android:textSize="@dimen/font_headline" >
                <tag android:id="@id/tag_typography_role" android:value="headline" />
            </TextView>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:text="@string/cloud_storage_description"
            android:textColor="@color/white_70"
            android:textSize="@dimen/font_body" >
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </TextView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_marginTop="@dimen/vs_16"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/vs_24" />

    </LinearLayout>

</FrameLayout>
