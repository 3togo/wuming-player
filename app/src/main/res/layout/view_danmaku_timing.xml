<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/vs_24"
        android:paddingVertical="@dimen/vs_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/danmaku_time_offset"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timeOffsetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/white"
            android:textSize="@dimen/font_label">
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.slider.Slider
        android:id="@+id/timeOffsetSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vs_12"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/tabTiming"
        android:stepSize="1000"
        android:valueFrom="-60000"
        android:valueTo="60000"
        app:tickVisible="false" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/vs_24"
        android:paddingTop="@dimen/vs_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/danmaku_duration"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/durationValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/white"
            android:textSize="@dimen/font_label">
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.slider.Slider
        android:id="@+id/durationSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vs_12"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:stepSize="500"
        android:valueFrom="3000"
        android:valueTo="15000"
        app:tickVisible="false" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/vs_24"
        android:paddingTop="@dimen/vs_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/danmaku_fixed_duration"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/fixedDurationValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/white"
            android:textSize="@dimen/font_label">
            <tag android:id="@id/tag_typography_role" android:value="label" />
        </com.google.android.material.textview.MaterialTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.slider.Slider
        android:id="@+id/fixedDurationSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vs_12"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:stepSize="500"
        android:valueFrom="2000"
        android:valueTo="10000"
        app:tickVisible="false" />

</androidx.appcompat.widget.LinearLayoutCompat>