<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/vs_8">

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/credential_name"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </EditText>

        <EditText
            android:id="@+id/serviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/credential_service_id"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </EditText>

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/credential_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </EditText>

        <Spinner
            android:id="@+id/method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:entries="@array/credential_method_entries"
            android:focusable="true"
            android:prompt="@string/credential_method" />

        <EditText
            android:id="@+id/secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/credential_secret"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textSize="@dimen/font_body">
            <tag android:id="@id/tag_typography_role" android:value="body" />
        </EditText>

    </LinearLayout>
</ScrollView>
