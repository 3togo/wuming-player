<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- do_not_remove: published-with-gradle-metadata -->
<modelVersion>4.0.0</modelVersion>
  <groupId>com.github.thegrizzlylabs</groupId>
  <artifactId>sardine-android</artifactId>
  <version>0.9</version>
  <packaging>aar</packaging>
  <name>thegrizzlylabs/sardine-android</name>
  <description>A WebDAV library for Android</description>
  <url>https://github.com/thegrizzlylabs/sardine-android</url>
  <inceptionYear>2017</inceptionYear>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://api.github.com/licenses/apache-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>thegrizzlylabs</id>
      <name>The Grizzly Labs</name>
      <email></email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/thegrizzlylabs/sardine-android.git</connection>
    <developerConnection>scm:git://github.com/thegrizzlylabs/sardine-android.git</developerConnection>
    <url>git://github.com/thegrizzlylabs/sardine-android.git</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.simpleframework</groupId>
      <artifactId>simple-xml</artifactId>
      <version>2.7.1</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <artifactId>xpp3</artifactId>
          <groupId>*</groupId>
        </exclusion>
        <exclusion>
          <artifactId>stax-api</artifactId>
          <groupId>*</groupId>
        </exclusion>
        <exclusion>
          <artifactId>stax</artifactId>
          <groupId>*</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
