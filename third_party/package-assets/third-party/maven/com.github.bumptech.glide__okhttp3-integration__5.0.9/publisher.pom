  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.bumptech.glide</groupId>
  <artifactId>okhttp3-integration</artifactId>
  <version>5.0.9</version>
  <packaging>aar</packaging>
  <name>Glide OkHttp 3.x Integration</name>
  <description>An integration library to use OkHttp 3.x to fetch data over http/https in Glide</description>
  <url>https://github.com/bumptech/glide</url>
  <licenses>
    <license>
      <name>Simplified BSD License</name>
