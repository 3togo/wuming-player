    {
      "id": "cast-remux-key-record",
      "kind": "compatibility-hold",
      "reason": "The remux key is a JVM record with a canonical constructor that defensively copies headers. Retain the small Java facade while cache, workers and lease ownership live in Kotlin.",
      "release_when": "Demonstrate a supported Kotlin replacement preserving record reflection, canonical constructor normalization and immutable headers with the existing Java contract tests.",
      "evidence": [
        "app/src/test/java/com/wuming/android/tv/server/process/CastRemuxCacheTest.java",
        "app/src/main/java/com/wuming/android/tv/server/process/CastRemuxCacheEngine.kt"
      ],
      "paths": [
