{
  "version": 1,
  "rules": [
    {
      "id": "hls-nullable-varargs",
      "kind": "language-required",
      "reason": "The published factory must accept a null array and retain JVM ACC_VARARGS. Ordinary Kotlin vararg emits a non-null array check. Keep only the entry facade in Java; normalization and orchestration stay in Kotlin.",
      "release_when": "Deliberately retire nullable-array compatibility or demonstrate a supported replacement preserving both null-array behavior and JVM varargs with the Java caller tests. Do not delete or weaken those tests to complete migration.",
      "evidence": [
        "libraries/playback-core/src/test/java/com/wuming/tv/core/playback/hls/HlsPipelineJavaContractTest.java",
        "libraries/playback-core/src/main/kotlin/com/wuming/tv/core/playback/hls/HlsPipelineEngine.kt"
      ],
      "paths": [
        "libraries/playback-core/src/main/java-required/com/wuming/tv/core/playback/hls/HlsPipeline.java"
      ],
      "markers": [
        "libraries/playback-core/src/main/java-required/com/wuming/tv/core/playback/hls/HlsPipeline.java"
      ]
    },
    {
      "id": "catvod-spider-api",
      "kind": "compatibility-hold",
      "reason": "Separately compiled provider jars subclass these API shells and use public fields, static factories, overloads, checked exceptions and nullable defaults. Kotlin is possible but requires explicit API parity evidence; Android and host implementations have different runtime behavior.",
      "release_when": "Compare affected public/protected JVM descriptors, fields, modifiers, checked exceptions, null and dispatch behavior against the old API and run representative precompiled-provider linkage tests on both hosts. Extract implementation behind unchanged entry points first when useful.",
      "evidence": [
        "docs/spider.md",
        "guarded-catvod-host/src/test/java/com/wuming/tv/guardhost/GuardedCatVodHostMainTest.java"
      ],
      "paths": [
        "catvod/src/main/java/com/github/catvod/crawler/Spider.java",
        "guarded-catvod-host/src/main/java/com/github/catvod/crawler/Spider.java"
      ],
      "markers": [
        "catvod/src/main/java/com/github/catvod/crawler/Spider.java",
        "guarded-catvod-host/src/main/java/com/github/catvod/crawler/Spider.java"
      ]
    },
