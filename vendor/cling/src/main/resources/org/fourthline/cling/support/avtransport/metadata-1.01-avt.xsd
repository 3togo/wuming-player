<?xml version="1.0" encoding="UTF-8"?>
<!-- Project-authored event-envelope schema, GPL-3.0. No copied UPnP specification text.
     Typed event variables are interpreted by Cling's EventedValue implementations. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:schemas-upnp-org:metadata-1-0/AVT/"
           elementFormDefault="qualified">
  <xs:element name="Event">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="InstanceID" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/></xs:sequence>
            <xs:attribute name="val" type="xs:unsignedInt" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
